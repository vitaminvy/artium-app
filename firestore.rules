rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Chỉ cho phép update các field liên quan follow counters
    function onlyFollowCountersChanged() {
      // Allow updates when only the stats map changes (followers/following)
      let diffKeys = request.resource.data.diff(resource.data).changedKeys();
      return diffKeys.hasOnly(["stats"]);
    }

    // Allow public read on artworks, artists, events, and posts
    match /artworks/{artworkId} {
      allow read: if true;
      allow write: if false;
    }
    match /artists/{artistId} {
      allow read: if true;
      allow write: if false;
    }
    match /editorials/{editorialId} {
      allow read: if true;
      allow write: if false; // No client-side writes allowed
    }
     match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }
    match /posts/{postId} {
      allow read: if true;
      allow write: if isSignedIn();
      
      // Allow any authenticated user to like/unlike
      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Allow any authenticated user to comment
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
      }
    }

    // Users can read their own data, and public profiles can be read by anyone
    match /users/{userId} {
      allow read: if true;
      allow create, delete: if isOwner(userId);
      allow update: if isOwner(userId) || (isSignedIn() && onlyFollowCountersChanged());

      // Explicitly allow access to event_rsvps subcollection
      match /event_rsvps/{rsvpId} {
        allow read: if true;
        allow write: if request.auth.uid == userId;
      }
      
      // Allow users to follow each other
      match /followers/{followerId} {
        allow read: if true;
        allow write: if request.auth.uid == followerId;
      }
      
      match /following/{followingId} {
        allow read: if true;
        allow write: if request.auth.uid == userId;
      }
    }

    // Allow collection group query for event_rsvps
    match /{path=**}/event_rsvps/{rsvpId} {
      allow read: if true;
    }
  }
}
