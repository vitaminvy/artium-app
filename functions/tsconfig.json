{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noEmit": false,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "lib": [
      "es2020"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": [
    "src",
    "nativewind-env.d.ts"
  ],
  "extends": "expo/tsconfig.base"
}
